# ============================================================
# The Social Scene — Dashboard Environment Template
# Copy this file to dashboard/.env.local
# ============================================================

# ================================
# SUPABASE (Client & Server)
# ================================
NEXT_PUBLIC_SUPABASE_URL=https://jkzlowhvromnaracfyja.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# SERVER ONLY — NEVER expose to browser/client
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional: Only needed if dashboard code directly connects via PostgreSQL connection string
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.jkzlowhvromnaracfyja.supabase.co:5432/postgres


# ================================
# DASHBOARD AUTH & EMAIL (Server Only)
# ================================
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=The Social Scene <no-reply@auth.thesocialscene.club>


# ================================
# FIREBASE CLIENT (Public)
# ================================
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_app_id:web:your_hash
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX


# ================================
# FIREBASE ADMIN — SERVER ONLY
# ================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_lines\n-----END PRIVATE KEY-----\n"


# ================================
# DOMAIN ROUTING
# ================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
