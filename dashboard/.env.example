# ============================================================
# The Social Scene — Dashboard Local Environment Template
# Copy this file to dashboard/.env.local
# ============================================================

# Supabase Client & Admin
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_secret_service_role_key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-supabase-project-id.supabase.co:5432/postgres

# Dashboard authentication/invitations
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
RESEND_API_KEY=re_your_sending_key
RESEND_FROM_EMAIL=The Social Scene <no-reply@auth.thesocialscene.club>

# Firebase Web Client
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_app_id:web:your_hash
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_lines\n-----END PRIVATE KEY-----\n"

# Domain Routing
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
