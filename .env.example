# Public Supabase Client Config (safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# PostgreSQL Direct Connection String (migrations / CLI only)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-supabase-project-id.supabase.co:5432/postgres

# Server-only Supabase Config (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Domain Routing
NEXT_PUBLIC_APP_URL=https://thesocialscene.club
NEXT_PUBLIC_ADMIN_URL=https://admin.thesocialscene.club

# Payments / Emails
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# SMS Provider
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
