# Public Supabase Client Config (Accessible in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# PostgreSQL Direct Connection String (For migrations / CLI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-supabase-project-id.supabase.co:5432/postgres

# Server-Only Supabase Config (NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Domain Routing Architecture
NEXT_PUBLIC_APP_URL=https://thesocialscene.club
NEXT_PUBLIC_ADMIN_URL=https://admin.thesocialscene.club

# Integration Abstractions (Payments & Emails)
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# SMS Provider Credentials (Supabase Auth SMS)
SMS_PROVIDER_KEY=sms_key_xxx
SMS_PROVIDER_SECRET=sms_secret_xxx

# Analytics Config
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-G4D8JB1ZBW
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxx
